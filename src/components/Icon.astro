---
// Lucide icons (https://lucide.dev), inlined at build time so no icon JavaScript ships to the browser.
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowDown from 'lucide-static/icons/arrow-down.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import circleCheck from 'lucide-static/icons/circle-check.svg?raw';
import circleAlert from 'lucide-static/icons/circle-alert.svg?raw';
import github from 'lucide-static/icons/github.svg?raw';
import linkedin from 'lucide-static/icons/linkedin.svg?raw';
import instagram from 'lucide-static/icons/instagram.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';

const icons = {
  'arrow-right': arrowRight,
  'arrow-down': arrowDown,
  'arrow-up-right': arrowUpRight,
  'circle-check': circleCheck,
  'circle-alert': circleAlert,
  github,
  linkedin,
  instagram,
  'map-pin': mapPin,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className = '', strokeWidth = 2 } = Astro.props;
const svg = icons[name]
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/class="[^"]*"/, `class="icon icon-${name} ${className}" aria-hidden="true" focusable="false"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`)
  .replace(/\s*\n\s*/g, ' ')
  .trim();
---

<Fragment set:html={svg} />
