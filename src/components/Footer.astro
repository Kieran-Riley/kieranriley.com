---
import { site } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__intro">
        <a class="site-footer__logo" href="/">Kieran <span>Riley.</span></a>
        <p>
          {site.role} based in {site.location}. Working directly with founders, individuals and businesses on a
          limited number of independent projects.
        </p>
        <p class="site-footer__location">
          <Icon name="map-pin" size={16} /> {site.location} · Available for remote projects across the UK
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="site-footer__heading">Explore</h2>
        <ul>
          <li><a href="/">About me</a></li>
          <li><a href="/work-with-me">Work with me</a></li>
          <li><a href="/work-with-me#services">Services</a></li>
          <li><a href="/work-with-me#enquire">Send an enquiry</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="site-footer__heading">Elsewhere</h2>
        <ul>
          {
            site.social.map((s) => (
              <li>
                <a href={s.href} rel="me noopener" target="_blank">
                  <Icon name={s.icon} size={16} /> {s.label}
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={site.agentsNe.href} rel="noopener" target="_blank">
              <Icon name="arrow-up-right" size={16} /> {site.agentsNe.label}
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Independent developer — not an agency.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night);
    color: var(--on-night-2);
    padding-block: clamp(3.5rem, 7vw, 5rem) 2rem;
    font-size: 0.95rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48em) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .site-footer__intro {
    max-width: 30rem;
  }

  .site-footer__logo {
    display: inline-block;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    color: var(--on-night);
    text-decoration: none;
  }

  .site-footer__logo span {
    color: var(--accent-on-night);
  }

  .site-footer__location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .site-footer__heading {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-night);
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem;
    color: var(--on-night-2);
    text-decoration: none;
  }

  ul a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--night-line);
    font-size: 0.85rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }
</style>
