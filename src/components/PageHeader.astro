---
interface Props {
  eyebrow?: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="page-header on-night">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h-section">{title}</h1>
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(7rem, 12vw, 9rem) clamp(3rem, 6vw, 4.5rem);
    background:
      radial-gradient(50rem 30rem at 80% 0%, rgb(43 89 195 / 0.25), transparent 70%),
      var(--night);
    color: var(--on-night);
  }

  .page-header :global(p:not(.eyebrow)) {
    max-width: 40rem;
    margin-top: 1.25rem;
    color: #d6dbe6;
    font-size: 1.1rem;
  }
</style>
