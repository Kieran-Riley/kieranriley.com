---
import { site } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header on-night" data-header>
  <div class="container site-header__inner">
    <a class="logo" href="/" aria-label={`${site.name}, home`}>
      Kieran <span>Riley.</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          site.nav.map((item) => (
            <li>
              <a class="nav-link" href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="header-cta" href="/work-with-me#enquire">
      Get in touch <Icon name="arrow-right" size={16} />
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--on-night);
    /* Every page starts with a dark section; this keeps the header legible regardless. */
    background: linear-gradient(180deg, rgb(11 19 34 / 0.6), rgb(11 19 34 / 0));
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      backdrop-filter 0.3s ease;
  }

  .site-header.is-scrolled {
    background: rgb(11 19 34 / 0.94);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    box-shadow: 0 1px 0 var(--night-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    height: 4.5rem;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    color: var(--on-night);
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }

  .logo span {
    color: var(--accent-on-night);
  }

  .nav-list {
    display: flex;
    gap: clamp(0.25rem, 2vw, 1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.5rem 0.4rem;
    color: var(--on-night-2);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: #fff;
  }

  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.4rem;
    right: 0.4rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-on-night);
  }

  .header-cta {
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--on-night);
    color: var(--night);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .header-cta:hover {
    background: #fff;
    color: var(--night);
  }

  @media (min-width: 40em) {
    .header-cta {
      display: inline-flex;
    }
  }
</style>
