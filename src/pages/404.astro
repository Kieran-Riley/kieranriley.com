---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found | Kieran Riley" description="This page doesn’t exist." noindex>
  <PageHeader eyebrow="404" title="Sorry, I can’t find that page.">
    <p>It may have moved, or the link might not be quite right.</p>
  </PageHeader>
  <section class="section">
    <div class="container btn-row">
      <a class="btn" href="/">Go to the homepage <Icon name="arrow-right" /></a>
      <a class="btn btn--ghost" href="/work-with-me">Work with me</a>
    </div>
  </section>
</BaseLayout>
