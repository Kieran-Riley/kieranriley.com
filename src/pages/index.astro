---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import heroImage from '../assets/images/hero.jpg';
import portrait from '../assets/images/kr.jpg';
import portraitSquare from '../assets/images/kr-square.png';

const title = 'Kieran Riley | Freelance Software Developer in Newcastle';
const description =
  'I’m Kieran, a full-stack developer in Newcastle with about six years’ experience at startups and scale-ups. I help people build new software, finish apps started with AI, and update older systems.';

const personImage = await getImage({ src: portraitSquare, width: 800, height: 800, format: 'jpg' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL('/', Astro.site).toString(),
  name: title,
  mainEntity: {
    '@type': 'Person',
    '@id': new URL('/#person', Astro.site).toString(),
    name: site.name,
    jobTitle: site.role,
    url: new URL('/', Astro.site).toString(),
    image: new URL(personImage.src, Astro.site).toString(),
    address: { '@type': 'PostalAddress', addressLocality: site.locality, addressCountry: site.country },
    knowsAbout: ['Full-stack software development', 'React', 'React Native', 'Python', 'Django', 'AI-assisted development'],
    sameAs: [...site.social.map((s) => s.href)],
  },
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: new URL('/', Astro.site).toString(),
  inLanguage: 'en-GB',
};

---

<BaseLayout title={title} description={description} jsonLd={[jsonLd, websiteLd]}>
  <section class="hero on-night" aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true">
      <Picture
        src={heroImage}
        alt=""
        widths={[480, 768, 1080, 1440, 1920, 2560]}
        sizes="100vw"
        formats={['webp']}
        quality={70}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__scrim"></div>
    </div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="hero__kicker hero__anim" style="--d: 0.1s">Kieran Riley · Newcastle</p>
        <h1 id="hero-title" class="h-display hero__anim" style="--d: 0.2s">
          Software developer. Product thinker. <span class="hero__accent">Here to help you build what’s next.</span>
        </h1>
        <p class="hero__copy hero__anim" style="--d: 0.35s">
          New idea, something you’ve started with AI, or a system that’s showing its age. I can help with the next step.
        </p>
        <div class="btn-row hero__anim" style="--d: 0.5s">
          <a class="btn btn--light" href="/work-with-me">Work with me <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost-light" href="#about">More about me</a>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-title">
    <div class="container about">
      <figure class="about__photo" data-reveal>
        <Picture
          src={portrait}
          alt="Kieran Riley at a laptop, listening during a discussion"
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 60em) 400px, (min-width: 40em) 60vw, 100vw"
          formats={['webp']}
          quality={72}
        />
      </figure>

      <div class="about__body" data-reveal>
        <h2 id="about-title" class="h-section">About me</h2>
        <p class="lede">
          I’ve been a full-stack developer for about six years, mostly at startups and scale-ups. I’ve built new
          products, looked after existing ones and modernised older systems.
        </p>
        <p>
          I like being involved in what gets built, not only how. Recent work includes AI-powered features, validation
          systems and improving platforms that are already in use.
        </p>
        <ul class="tags" aria-label="Main technologies">
          <li>React</li>
          <li>React Native</li>
          <li>Python</li>
          <li>Django</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ai-title">
    <div class="container two-col">
      <h2 id="ai-title" class="h-section" data-reveal>Building with AI</h2>
      <div data-reveal>
        <p class="lede">
          I use coding agents every day and I’ve helped plenty of people get started with them.
        </p>
        <p>
          AI tools let you build a lot more on your own. I help with the parts they still struggle with: architecture,
          security, reliability and keeping the code maintainable.
        </p>
        <a class="agents" href={site.agentsNe.href} target="_blank" rel="noopener">
          <span>
            Co-founder of <strong>{site.agentsNe.label}</strong>, helping people and businesses get started with AI.
          </span>
          <Icon name="arrow-up-right" size={20} />
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--night" aria-labelledby="approach-title">
    <div class="container approach">
      <h2 id="approach-title" class="h-section" data-reveal>
        A developer in your corner, not an agency on your payroll.
      </h2>
      <div class="approach__body" data-reveal>
        <p class="lede">
          You deal with me directly. I take on a small number of projects at a time, give straight advice and suggest
          what fits your budget, even if that’s just a second opinion.
        </p>
        <div class="approach__sign">
          <Picture src={portraitSquare} alt="" widths={[96, 192]} sizes="56px" formats={['webp']} />
          <span>Kieran</span>
        </div>
        <div class="btn-row">
          <a class="btn btn--light" href="/work-with-me">Work with me <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background:
      radial-gradient(60rem 40rem at 85% 10%, rgb(43 89 195 / 0.16), transparent 70%),
      var(--night);
    color: var(--on-night);
    overflow: hidden;
  }

  .hero__media {
    position: relative;
    height: min(66svh, 38rem);
    animation: hero-bg 1.6s var(--ease-out) both;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero__media :global(img) {
    object-fit: cover;
    object-position: 35% 52%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(11 19 34 / 0.65) 0%, rgb(11 19 34 / 0) 18%),
      linear-gradient(0deg, var(--night) 0%, var(--night) 8%, rgb(11 19 34 / 0.8) 24%, rgb(11 19 34 / 0) 55%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    margin-top: -4.5rem;
    padding-bottom: clamp(3.5rem, 8vh, 5rem);
  }

  .hero__content {
    max-width: 40rem;
  }

  .hero h1 {
    font-size: clamp(2.35rem, 9vw, 3rem);
    margin-bottom: 1.5rem;
  }

  .hero__accent {
    color: #c9d8ff;
  }

  .hero__kicker {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #d6dbe6;
  }

  .hero__copy {
    max-width: 32rem;
    margin-bottom: 2rem;
    font-size: clamp(1.05rem, 1.3vw, 1.175rem);
    color: #d6dbe6;
  }

  @media (min-width: 48em) {
    .hero h1 {
      font-size: clamp(3rem, 6.5vw, 4rem);
    }
  }

  @media (min-width: 60em) {
    .hero {
      flex-direction: row;
      align-items: center;
    }

    .hero__media {
      position: absolute;
      inset: 0 auto 0 0;
      width: 58%;
      height: auto;
    }

    .hero__media :global(img) {
      object-position: 30% 60%;
    }

    .hero__scrim {
      background:
        linear-gradient(180deg, rgb(11 19 34 / 0.7) 0%, rgb(11 19 34 / 0) 16%),
        linear-gradient(0deg, rgb(11 19 34 / 0.6) 0%, rgb(11 19 34 / 0) 25%),
        linear-gradient(90deg, rgb(11 19 34 / 0) 40%, rgb(11 19 34 / 0.55) 75%);
    }

    .hero__media {
      -webkit-mask-image: linear-gradient(90deg, #000 45%, transparent 96%);
      mask-image: linear-gradient(90deg, #000 45%, transparent 96%);
    }

    .hero__inner {
      margin-top: 0;
      padding-block: 7rem 4rem;
      display: flex;
      justify-content: flex-end;
    }

    .hero__content {
      width: 56%;
      max-width: 38rem;
    }

    .hero h1 {
      font-size: clamp(3rem, 4.6vw, 4.6rem);
    }
  }

  .hero__anim {
    animation: hero-in 1.1s var(--ease-out) both;
    animation-delay: calc(0.35s + var(--d, 0s));
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes hero-bg {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
  }

  /* ---------- About ---------- */
  .about {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (min-width: 60em) {
    .about {
      grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    }
  }

  .about__photo {
    margin: 0;
    max-width: 400px;
  }

  .about__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 45% 30%;
    border-radius: var(--radius-lg);
  }

  .about__body {
    max-width: 36rem;
  }

  .about__body h2 {
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  /* ---------- Two column ---------- */
  .two-col {
    display: grid;
    gap: 1.5rem clamp(2.5rem, 6vw, 5rem);
  }

  @media (min-width: 60em) {
    .two-col {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .two-col > div {
    max-width: 36rem;
  }

  .agents {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .agents:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  .agents :global(svg) {
    flex: none;
    color: var(--accent);
  }

  /* ---------- Approach ---------- */
  .approach {
    display: grid;
    gap: 1.5rem clamp(2.5rem, 6vw, 5rem);
  }

  @media (min-width: 60em) {
    .approach {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .approach__body {
    max-width: 34rem;
  }

  .approach__sign {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.75rem 0 2rem;
    font-weight: 600;
  }

  .approach__sign :global(img) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
  }
</style>
