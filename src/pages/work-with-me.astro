---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';
import { principles, services } from '../data/services';
import portraitSquare from '../assets/images/kr-square.png';

const title = 'Work With Me | Kieran Riley, Freelance Software Developer';
const description =
  'Freelance software development from Newcastle. New builds and MVPs, help finishing apps made with Lovable, Replit or Cursor, updating older systems, code reviews and ongoing support.';

const pageUrl = new URL('/work-with-me', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'en-GB',
  mainEntity: {
    '@type': 'OfferCatalog',
    name: 'Software development services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        description: s.summary,
        url: `${pageUrl}#${s.id}`,
        areaServed: { '@type': 'Country', name: 'United Kingdom' },
        provider: { '@type': 'Person', '@id': new URL('/#person', Astro.site).toString(), name: site.name },
      },
    })),
  },
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="page-hero on-night" aria-labelledby="wwm-title">
    <div class="container page-hero__inner">
      <div>
        <h1 id="wwm-title" class="h-display hero-anim" style="--d: 0.1s">
          Let’s build something that works <span class="accent">for you.</span>
        </h1>
        <p class="page-hero__copy hero-anim" style="--d: 0.2s">
          Got an idea, an app you started with AI, or an old system that needs work? I’d like to hear about it.
        </p>
        <div class="btn-row hero-anim" style="--d: 0.3s">
          <a class="btn btn--light" href="#enquire">Tell me about your project <Icon name="arrow-down" /></a>
        </div>
      </div>

      <figure class="page-hero__photo hero-anim" style="--d: 0.2s">
        <Picture
          src={portraitSquare}
          alt="Kieran Riley"
          widths={[320, 520, 800]}
          sizes="(min-width: 60em) 360px, 260px"
          formats={['webp']}
          quality={74}
          loading="eager"
        />
        <figcaption>You’ll work with me directly.</figcaption>
      </figure>
    </div>
  </section>

  <section id="services" class="section" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="h-section section-title" data-reveal>How I can help</h2>
      <div class="services">
        {
          services.map((s, i) => (
            <article
              id={s.id}
              class:list={['service', { 'service--featured': s.featured }]}
              aria-labelledby={`${s.id}-title`}
              data-reveal
              style={`--reveal-delay: ${(i % 2) * 0.06}s`}
            >
              <h3 id={`${s.id}-title`}>{s.title}</h3>
              <p class="service__summary">{s.summary}</p>
              <ul class="tick-list">
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {s.notes?.map((n) => (
                <p class="service__note">{n}</p>
              ))}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="principles-title">
    <div class="container">
      <h2 id="principles-title" class="h-section section-title" data-reveal>How I work</h2>
      <dl class="principles" data-reveal>
        {
          principles.map((p) => (
            <div>
              <dt>{p.title}</dt>
              <dd>{p.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="enquire" class="section" aria-labelledby="enquire-title">
    <div class="container enquire">
      <div class="enquire__intro" data-reveal>
        <h2 id="enquire-title" class="h-section">Tell me about your project</h2>
        <p class="lede">No hard sell. I’ll reply within {site.responseTime}.</p>
      </div>
      <div data-reveal>
        <EnquiryForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .page-hero {
    padding-block: clamp(7rem, 13vw, 9.5rem) clamp(3.5rem, 7vw, 5rem);
    background: var(--night);
    color: var(--on-night);
  }

  .page-hero__inner {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: center;
  }

  @media (min-width: 60em) {
    .page-hero__inner {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.4rem);
    margin-bottom: 1.5rem;
    max-width: 14ch;
  }

  .accent {
    color: #c9d8ff;
  }

  .page-hero__copy {
    max-width: 32rem;
    margin-bottom: 2rem;
    font-size: clamp(1.05rem, 1.3vw, 1.175rem);
    color: #d6dbe6;
  }

  .page-hero__photo {
    margin: 0;
    width: 100%;
    max-width: 360px;
  }

  @media (max-width: 59.99em) {
    .page-hero__photo {
      max-width: 260px;
    }
  }

  .page-hero__photo :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 45% 30%;
    border-radius: var(--radius-lg);
  }

  .page-hero__photo figcaption {
    margin-top: 0.85rem;
    font-size: 0.95rem;
    color: var(--on-night-2);
  }

  .hero-anim {
    animation: hero-in 1s var(--ease-out) both;
    animation-delay: calc(0.2s + var(--d, 0s));
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  .section-title {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* ---------- Services ---------- */
  .services {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 52em) {
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .service h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    margin-bottom: 0.6rem;
  }

  .service__summary {
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }

  .service .tick-list {
    gap: 0.45rem;
    font-size: 0.98rem;
  }

  .service__note {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .service__note + .service__note {
    margin-top: 0.6rem;
  }

  .service--featured {
    background: var(--night);
    border-color: var(--night);
    color: var(--on-night);
  }

  .service--featured .service__summary,
  .service--featured .service__note {
    color: var(--on-night-2);
  }

  .service--featured .tick-list + .service__note {
    padding-top: 1.25rem;
    border-top: 1px solid var(--night-line);
    color: var(--on-night);
  }

  .service--featured .tick-list li::before {
    border-color: var(--accent-on-night);
  }

  /* ---------- Principles ---------- */
  .principles {
    display: grid;
    gap: 0 3rem;
    margin: 0;
  }

  @media (min-width: 52em) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }

  .principles > div {
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }

  .principles dt {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    margin-bottom: 0.25rem;
  }

  .principles dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* ---------- Enquiry ---------- */
  .enquire {
    display: grid;
    gap: 2.5rem 4rem;
  }

  @media (min-width: 64em) {
    .enquire {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      align-items: start;
    }

    .enquire__intro {
      position: sticky;
      top: 6.5rem;
    }
  }

  .enquire__intro h2 {
    margin-bottom: 1rem;
  }
</style>
