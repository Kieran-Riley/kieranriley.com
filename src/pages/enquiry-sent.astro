---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { successMessage } from '../data/enquiry';
---

<BaseLayout title="Enquiry sent | Kieran Riley" description="Thanks for getting in touch." noindex>
  <PageHeader eyebrow="Enquiry sent" title="Thanks for getting in touch!">
    <p>{successMessage.replace('Thanks for getting in touch! ', '')}</p>
  </PageHeader>
  <section class="section">
    <div class="container">
      <p class="muted">A confirmation is on its way to your inbox. If you don’t see it, check your spam folder.</p>
      <div class="btn-row" style="margin-top: 2rem">
        <a class="btn" href="/">Back to the homepage <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>
