# Copy to .env for local development. Set the same values in your hosting provider.

# Public site URL (used for canonical URLs, Open Graph and the sitemap)
SITE_URL=https://kieranriley.com
# Extra hostnames the server should accept requests for (comma separated),
# e.g. your host's default domain while testing: my-site.up.railway.app
ALLOWED_DOMAINS=

# Resend (https://resend.com) — required in production for the enquiry form.
RESEND_API_KEY=
# Where new enquiries are sent
ENQUIRY_TO_EMAIL=
# Sender for both emails. The domain must be verified in Resend.
ENQUIRY_FROM_EMAIL="Kieran Riley <hello@kieranriley.com>"

# Optional: Cloudflare Turnstile spam protection. Leave blank to disable.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
